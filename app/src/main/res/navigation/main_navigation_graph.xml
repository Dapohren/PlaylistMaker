<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_navigation_graph"
    app:startDestination="@id/mediaLibraryFragment">
    <fragment
        android:id="@+id/mediaLibraryFragment"
        android:name="com.example.playlistmaker.media.ui.MediaFragment"
        android:label="fragment_media"
        tools:layout="@layout/fragment_media" >
        <action
            android:id="@+id/action_mediaLibraryFragment_to_newPlaylistFragment"
            app:destination="@+id/newPlaylistFragment"/>
        <action
            android:id="@+id/action_mediaLibraryFragment_to_playlistInformationFragment"
            app:destination="@+id/playlistInformationFragment"
            />
    </fragment>
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.playlistmaker.search.ui.SearchFragment"
        android:label="fragment_search"
        tools:layout="@layout/fragment_search" />
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.playlistmaker.settings.ui.SettingsFragment"
        android:label="fragment_settings"
        tools:layout="@layout/fragment_settings" />
    <fragment
        android:id="@+id/newPlaylistFragment"
        android:name="com.example.playlistmaker.media.ui.playlist.NewPlaylistFragment"
        android:label="fragment_new_playlist"
        tools:layout="@layout/fragment_new_playlist"
        />
    <fragment
        android:id="@+id/playlistInformationFragment"
        android:name="com.example.playlistmaker.playlist.ui.PlaylistInformationFragment"
        android:label="PlaylistInformationFragment">
        <action
            android:id="@+id/action_playlistInformationFragment_to_editPlaylistFragment"
            app:destination="@+id/editPlaylistFragment"/>
    </fragment>
    <fragment
        android:id="@+id/editPlaylistFragment"
        android:name="com.example.playlistmaker.playlist.ui.EditPlaylistFragment"
        android:label="EditPlaylistFragment" />


</navigation>