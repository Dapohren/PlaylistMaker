<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    android:id="@+id/coordLayout"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".playlist.ui.PlaylistInformationFragment">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/light_grey">
    <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="7">

    <ImageView
        android:id="@+id/backButton"
        android:layout_width="24dp"
        android:layout_height="0dp"
        android:src="@drawable/left"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="20dp"
        app:tint="@color/black" />
    <ImageView
        app:layout_constraintHeight_percent="0.63"
        android:src="@drawable/placeholder2"
        android:id="@+id/imageAlbum"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:clipToOutline="true"
        />
    <TextView
        android:id="@+id/albumName"
        app:layout_constraintHeight_percent="0.090"
        app:layout_constraintTop_toBottomOf="@+id/imageAlbum"
        app:layout_constraintStart_toStartOf="parent"
        android:padding="10dp"
        android:ellipsize="end"
        android:layout_marginStart="10dp"
        android:text="PlaylistName"
        android:textFontWeight="700"
        android:lines="1"
        android:textColor="@color/black"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/albumDescription"
        android:fontFamily="@font/ys_display_medium"
        android:textSize="24sp"
        android:layout_width="wrap_content"
        android:layout_height="0dp"/>
    <TextView
        android:id="@+id/albumDescription"
        app:layout_constraintHeight_percent="0.045"
        app:layout_constraintTop_toBottomOf="@+id/albumName"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="20dp"
        android:text="2002"
        android:lines="1"
        android:textFontWeight="400"
        android:textSize="18sp"
        android:textColor="@color/black"
        android:fontFamily="@font/ys_display_regular"
        android:layout_width="wrap_content"
        android:layout_height="0dp"/>
    <TextView
        android:id="@+id/tracksTime"
        app:layout_constraintHeight_percent="0.045"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/albumDescription"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:text="300"
        android:textSize="18sp"
        android:textColor="@color/black"
        android:fontFamily="@font/ys_display_regular"
        android:layout_width="wrap_content"
        android:layout_height="0dp"/>

    <ImageView
        android:id="@+id/ic"
        app:layout_constraintTop_toTopOf="@+id/tracksTime"
        app:layout_constraintStart_toEndOf="@+id/tracksTime"
        app:layout_constraintBottom_toBottomOf="@id/tracksTime"
        android:layout_width="wrap_content"
        android:layout_margin="6dp"
        android:layout_height="wrap_content"
        android:src="@drawable/ic__1_"
        app:iconTint="@color/black"
        app:iconGravity="textEnd"
        />

    <TextView
        app:layout_constraintHeight_percent="0.045"
        android:id="@+id/tracksCount"
        app:layout_constraintStart_toEndOf="@+id/ic"
        app:layout_constraintTop_toBottomOf="@+id/albumDescription"
        android:fontFamily="@font/ys_display_regular"
        android:textSize="18sp"
        app:layout_constraintBaseline_toBaselineOf="@id/tracksTime"
        android:text="98 треков"
        android:textColor="@color/black"
        android:layout_width="wrap_content"
        android:layout_height="0dp"/>
    <ImageView
        app:layout_constraintHeight_percent="0.04"
        android:id="@+id/buttonShare"
        app:layout_constraintTop_toBottomOf="@+id/tracksTime"
        app:layout_constraintStart_toStartOf="parent"
        android:src="@drawable/light_mode_dark"
        android:layout_marginTop="7dp"
        android:layout_marginStart="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ImageView
        android:id="@+id/three"
        app:layout_constraintHeight_percent="0.04"
        app:layout_constraintTop_toBottomOf="@+id/tracksCount"
        app:layout_constraintStart_toEndOf="@+id/buttonShare"
        android:src="@drawable/three"
        android:padding="11dp"
        android:paddingStart="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View android:id="@+id/overlay"
        android:layout_weight="3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="center"
        />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/backgroundColor"
        android:orientation="vertical"
        app:behavior_hideable="false"
        app:behavior_peekHeight="265dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:layout_width="50dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:background="@drawable/rounded_rectangle_swap" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewSongs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="24dp" />

    </LinearLayout>

        <View android:id="@+id/overlay2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000"
            android:visibility="gone"
            />

        <LinearLayout
            android:visibility="gone"
            android:id="@+id/menu_bottom_sheet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/rounded_rectangle_bottomsheet"
            android:orientation="vertical"
            android:paddingHorizontal="5dp"
            app:behavior_hideable="true"
            app:behavior_peekHeight="360dp"
            android:backgroundTint="?attr/backgroundColor"
            app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
            <View
                android:layout_width="50dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/dp_8"
                android:background="@drawable/rounded_rectangle_swap"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="61dp"
                android:layout_marginTop="12dp">

                <ImageView
                    android:id="@+id/bottomSheetPlaylistPhoto"
                    android:contentDescription="Фото плейлиста"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_marginStart="13dp"
                    android:layout_marginTop="@dimen/dp_8"
                    android:layout_marginBottom="@dimen/dp_8"
                    tools:src="@drawable/placeholder"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    />

                <TextView
                    android:id="@+id/bottomSheetPlaylistName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:text="Best Songs 2021"
                    android:textColor="?attr/colorOnPrimary"
                    android:layout_marginStart="@dimen/dp_8"
                    android:layout_marginTop="14dp"
                    android:lines="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/ys_display_regular"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/bottomSheetPlaylistPhoto"
                    app:layout_constraintEnd_toEndOf="parent"
                    />

                <TextView
                    android:id="@+id/bottomSheetTracksNumber"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:text="98 треков"
                    android:textColor="@color/grey"
                    android:layout_marginTop="1dp"
                    android:lines="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/ys_display_regular"
                    app:layout_constraintTop_toBottomOf="@id/bottomSheetPlaylistName"
                    app:layout_constraintStart_toStartOf="@id/bottomSheetPlaylistName"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/bottomSheetButtonShare"
                android:layout_width="match_parent"
                android:layout_height="61dp"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:text="Поделиться"
                android:textColor="?attr/colorOnPrimary"
                android:lines="1"
                android:ellipsize="end"
                android:fontFamily="@font/ys_display_regular" />

            <TextView
                android:id="@+id/bottomSheetButtonChangeInfo"
                android:layout_width="match_parent"
                android:layout_height="61dp"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:text="Редактировать информацию"
                android:textColor="?attr/colorOnPrimary"
                android:lines="1"
                android:ellipsize="end"
                android:fontFamily="@font/ys_display_regular" />

            <TextView
                android:id="@+id/bottomSheetButtonDeletePlaylist"
                android:layout_width="match_parent"
                android:layout_height="61dp"
                android:textSize="16sp"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:text="Удалить плейлист"
                android:textColor="?attr/colorOnPrimary"
                android:lines="1"
                android:ellipsize="end"
                android:fontFamily="@font/ys_display_regular" />

        </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
