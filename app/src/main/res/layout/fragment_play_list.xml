<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/backgroundColor"
    tools:context=".player.ui.AudioPlayerActivity">

    <Button
        android:layout_marginBottom="40dp"
        android:id="@+id/button_new_playlist"
        android:text="@string/button_new_playlist"
        android:backgroundTint="?attr/colorOnPrimary"
        android:textColor="?attr/backgroundColor"
        android:fontFamily="@font/ys_display_medium"
        android:textSize="@dimen/text_size_update"
        android:padding="@dimen/icon_padding_big_button"
        app:layout_constraintBottom_toTopOf="@+id/empty_list_image"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <ImageView
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/empty_list_image"
        android:gravity="center"
        style="@style/NothingFound"
        android:contentDescription="@string/nothing_found"/>
    <TextView
        app:layout_constraintTop_toBottomOf="@+id/empty_list_image"
        android:id="@+id/empty_list_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:fontFamily="@font/ys_display_medium"
        android:text="@string/empty_playlist"
        android:textSize="@dimen/padding_top_settings_button"
        android:paddingStart="24dp"/>


</androidx.constraintlayout.widget.ConstraintLayout>